  },
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Prediction Requests",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(titanic_prediction_requests_total[1m])",
          "legendFormat": "prediction/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction Errors",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(titanic_prediction_errors_total[5m])",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction Outcomes",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (prediction_label) (increase(titanic_prediction_outcomes_total[30m]))",
          "legendFormat": "{{prediction_label}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Meilisearch Requests",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(titanic_meilisearch_search_requests_total[1m])",
          "legendFormat": "search/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Meilisearch Failures",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(titanic_meilisearch_search_failures_total[10m])",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    }
